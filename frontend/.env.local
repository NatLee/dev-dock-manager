# Where the dashboard sends API and WebSocket calls. Empty means "the address the page was
# opened from", which is right whenever the dashboard is served through Traefik (any host, any
# port). Set it only when the frontend runs on its own, e.g. `npm run dev` on :3000 with the
# stack on :8000: NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_API_ORIGIN=
