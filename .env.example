# Copy to .env (next to docker-compose.yml) and fill in. .env is git-ignored.

# Signs sessions and the login tokens. Anyone who knows it can forge a login, so use a long
# random value, e.g.
#   openssl rand -base64 48
DJANGO_SECRET_KEY=

# Django's debug pages (stack traces, settings). Leave at 0 unless you are developing.
DJANGO_DEBUG=0
